{
  "name": "taskly-policy-web",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "worker"
  ],
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-data.mjs content public",
    "dev": "next dev",
    "build": "node scripts/verify-content.mjs && next build --webpack && node scripts/prepare-data.mjs content out",
    "start": "node scripts/serve-out.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:all": "npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@digital-go-jp/design-tokens": "2.1.0",
    "diff": "9.0.0",
    "markdown-it": "14.3.3",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@cloudflare/vite-plugin": "2.0.0-rc.1",
    "@digital-go-jp/tailwind-theme-plugin": "2.0.0",
    "@playwright/test": "1.65.1",
    "@types/markdown-it": "14.1.2",
    "@types/node": "22.19.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "autoprefixer": "10.6.2",
    "cf": "1.0.0-rc.1",
    "postcss": "8.5.33",
    "tailwindcss": "3.4.19",
    "typescript": "7.0.2",
    "vite": "7.3.8",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=26.12.0 <27"
  }
}
